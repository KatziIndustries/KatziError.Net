<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    
    <RepositoryType>git</RepositoryType>
    <ProjectUrl>https://github.com/KatziIndustries/KatziError.Net</ProjectUrl>
    <RepositoryUrl>https://github.com/KatziIndustries/KatziError.Net.git</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageId>KatziError.Net</PackageId>
    <Version>1.0.1</Version>
    <Authors>AaronoLW</Authors>
    <Description>KatziError C# bindings</Description>
  </PropertyGroup>
  
  <ItemGroup>
    <None Include="buildTransitive/KatziError.Net.targets" Pack="true" PackagePath="buildTransitive/" />
    <None Include="native/linux-x64/libkerror.so" Pack="true" PackagePath="runtimes/linux-x64/native/" />
    <None Include="native/linux-x64/libkerror.a"  Pack="true" PackagePath="native/linux-x64/" />
    
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  
  <ItemGroup>
    <None Include="native/linux-x64/libkerror.so" CopyToOutputDirectory="PreserveNewest" Link="libkerror.so" Visible="false" />
  </ItemGroup>
  
  <ItemGroup>
    <Compile Remove="Test/**" />
  </ItemGroup>
  
</Project>
